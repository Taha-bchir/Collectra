# Web app environment. Copy to .env.local and set every value.
# No defaults: all variables are required for the app to run.

# Backend API base URL (no trailing slash). Used for all API requests.
NEXT_PUBLIC_API_URL=

# OpenRouter hosted API key for the support chatbot. Keep this server-side only.
OPENROUTER_API_KEY=

# OpenRouter API base URL and model used by the support chatbot.
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324

# Optional metadata headers recommended by OpenRouter.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Collectra

# Enables the Stripe Checkout button in the public client debt page.
# Set to false to hide Stripe payment UI.
NEXT_PUBLIC_ENABLE_STRIPE_PAYMENT=true

# Enables demo-only fake payment button in the public client debt page.
NEXT_PUBLIC_ENABLE_DEMO_PAYMENT=false

# Unique key for persisting auth state in localStorage. Use a unique value per app/deployment (e.g. mycompany.myapp.auth).
NEXT_PUBLIC_APP_AUTH_STORAGE_KEY=

# Unique key for persisting user preferences in localStorage. Use a unique value per app/deployment (e.g. mycompany.myapp.preferences).
NEXT_PUBLIC_APP_PREFERENCES_STORAGE_KEY=

# Default theme: one of light | dark | system
NEXT_PUBLIC_DEFAULT_THEME=

# Default role selected on sign-up: one of Dealer | broker | showroom | admin | demo
NEXT_PUBLIC_DEFAULT_SIGNUP_ROLE=
